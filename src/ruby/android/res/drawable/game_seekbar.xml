<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background track -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <size android:height="12dp"/>
            <solid android:color="#5b5b5b5b"/>
            <corners android:radius="6dp"/>
            <stroke
                android:width="2dp"
                android:color="#89898989"/>
        </shape>
    </item>

    <!-- Secondary progress (buffered/preview value) -->
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="12dp"/>
                <solid android:color="#7a7a7a7a"/>
                <corners android:radius="6dp"/>
            </shape>
        </clip>
    </item>

    <!-- Current progress -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="12dp"/>
                <corners android:radius="6dp"/>
                <gradient
                    android:type="linear"
                    android:angle="270"
                    android:startColor="#d0d0d0d0"
                    android:endColor="#a0a0a0a0"/>
                <stroke
                    android:width="1dp"
                    android:color="#89898989"/>
            </shape>
        </clip>
    </item>

</layer-list>